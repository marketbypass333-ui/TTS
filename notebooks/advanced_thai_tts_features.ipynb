    "## 4. Voice Conversion and Style Transfer\n",
    "\n",
    "Convert voices between different styles and characteristics."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class VoiceConverter:\n",
    "    \"\"\"Voice conversion and style transfer\"\"\"\n",
    "    \n",
    "    def __init__(self, tts_model):\n",
    "        self.tts = tts_model\n",
    "        self.sample_rate = 22050\n",
    "    \n",
    "    def convert_style(self, text, reference_wav, style_params):\n",
    "        \"\"\"Convert voice style\"\"\"\n",
    "        try:\n",
    "            # Style parameters\n",
    "            speed = style_params.get('speed', 1.0)\n",
    "            pitch = style_params.get('pitch', 1.0)\n",
    "            energy = style_params.get('energy', 1.0)\n",
    "            \n",
    "            # Generate base audio\n",
    "            audio = self.tts.tts(\n",
    "                text=text,\n",
    "                speaker_wav=reference_wav,\n",
    "                language=\"th\"\n",
    "            )\n",
    "            \n",
    "            # Convert to numpy\n",
    "            if isinstance(audio, torch.Tensor):\n",
    "                audio = audio.cpu().numpy()\n",
    "            \n",
    "            # Apply style modifications\n",
    "            modified_audio = self._apply_style_modifications(\n",
    "                audio, speed, pitch, energy\n",
    "            )\n",
    "            \n",
    "            return modified_audio\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error converting style: {e}\")\n",
    "            return None\n",
    "    \n",
    "    def _apply_style_modifications(self, audio, speed, pitch, energy):\n",
    "        \"\"\"Apply style modifications to audio\"\"\"\n",
    "        try:\n",
    "            # Speed modification (simple resampling)\n",
    "            if speed != 1.0:\n",
    "                audio = librosa.effects.time_stretch(audio, rate=speed)\n",
    "            \n",
    "            # Pitch modification\n",
    "            if pitch != 1.0:\n",
    "                n_steps = 12 * (pitch - 1)  # Convert to semitones\n",
    "                audio = librosa.effects.pitch_shift(\n",
    "                    audio, sr=self.sample_rate, n_steps=n_steps\n",
    "                )\n",
    "            \n",
    "            # Energy modification (amplitude)\n",
    "            if energy != 1.0:\n",
    "                audio = audio * energy\n",
    "            \n",
    "            return audio\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error applying style: {e}\")\n",
    "            return audio\n",
    "    \n",
    "    def create_style_variations(self, text, reference_wav, output_dir):\n",
    "        \"\"\"Create multiple style variations\"\"\"\n",
",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "        \n",
    "        # Style configurations\n",
    "        styles = {\n",
    "            \"normal\": {'speed': 1.0, 'pitch': 1.0, 'energy': 1.0},\n",
    "            \"fast\": {'speed': 1.3, 'pitch': 1.0, 'energy': 1.1},\n",
    "            \"slow\": {'speed': 0.7, 'pitch': 1.0, 'energy': 0.9},\n",
    "            \"high_pitch\": {'speed': 1.0, 'pitch': 1.4, 'energy': 1.0},\n",
    "            \"low_pitch\": {'speed': 1.0, 'pitch': 0.7, 'energy': 1.0},\n",
",
    "            \"excited\": {'speed': 1.2, 'pitch': 1.2, 'energy': 1.3},\n",
    "            \"calm\": {'speed': 0.8, 'pitch': 0.9, 'energy': 0.8}\n",
    "        }\n",
    "        \n",
    "        generated_files = []\n",
    "        \n",
    "        for style_name, params in styles.items():\n",
    "            print(f\"Generating {style_name} style...\")\n",
    "            \n",
    "            audio = self.convert_style(text, reference_wav, params)\n",
    "            \n",
    "            if audio is not None:\n",
    "                output_path = os.path.join(output_dir, f\"{style_name}.wav\")\n",
    "                sf.write(output_path, audio, self.sample_rate)\n",
    "                generated_files.append(output_path)\n",
    "                print(f\"✅ Generated {style_name}: {output_path}\")\n",
    "        \n",
    "        return generated_files\n",
    "\n",
    "# Test voice conversion\n",
    "print(\"=== Voice Conversion and Style Transfer ===\")\n",
    "voice_converter = VoiceConverter(tts)\n",
    "\n",
    "# Create reference audio if not exists\n",
    "reference_text = \"สวัสดีครับ นี่คือการทดสอบการแปลงเสียง\"\n",
    "reference_path = \"reference_vc.wav\"\n",
    "\n",
    "# Generate reference if not exists\n",
    "if not os.path.exists(reference_path):\n",
    "    audio = tts.tts(text=reference_text, language=\"th\")\n",
    "    if isinstance(audio, torch.Tensor):\n",
    "        audio = audio.cpu().numpy()\n",
    "    sf.write(reference_path, audio, 22050)\n",
    "\n",
    "# Create style variations\n",
    "style_text = \"อรุณสวัสดิ์ค่ะ วันนี้คุณรู้สึกอย่างไรบ้าง\"\n",
",
    "style_files = voice_converter.create_style_variations(\n",
    "    style_text, reference_path, \"style_variations\"\n",
    ")\n",
    "\n",
    "print(f\"\\n✅ Generated {len(style_files)} style variations\")"
   ]
  },
