    "## 3. Thai Phoneme Analysis\n",
    "\n",
    "Analyze Thai phonemes and their characteristics."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def analyze_thai_phonemes(text):\n",
    "    \"\"\"Analyze Thai phonemes in text\"\"\"\n",
    "    # Thai consonants\n",
    "    thai_consonants = 'กขฃคฅฆงจฉชซฌญฎฏฐฑฒณดตถทธนบปผพฟภมยรลวศษสหฬอฮ'\n",
    "    \n",
    "    # Thai vowels\n",
    "    thai_vowels = 'ะาำิีึืุูเแโใไ็่้๊๋์'\n",
    "    \n",
    "    # Thai tones\n",
    "    thai_tones = '่้๊๋'\n",
    "    \n",
    "    consonant_count = sum(1 for char in text if char in thai_consonants)\n",
    "    vowel_count = sum(1 for char in text if char in thai_vowels)\n",
    "    tone_count = sum(1 for char in text if char in thai_tones)\n",
    "    \n",
    "    total_thai_chars = sum(1 for char in text if ord(char) > 0x0E00 and ord(char) < 0x0E7F)\n",
    "    \n",
    "    return {\n",
    "        'consonants': consonant_count,\n",
    "        'vowels': vowel_count,\n",
    "        'tones': tone_count,\n",
    "        'total_thai_chars': total_thai_chars,\n",
    "        'consonant_ratio': consonant_count / max(total_thai_chars, 1),\n",
    "        'vowel_ratio': vowel_count / max(total_thai_chars, 1),\n",
    "        'tone_ratio': tone_count / max(total_thai_chars, 1)\n",
    "    }\n",
    "\n",
    "def visualize_phoneme_distribution(texts):\n",
    "    \"\"\"Visualize phoneme distribution across multiple texts\"\"\"\n",
    "    results = []\n",
    "    \n",
    "    for text in texts:\n",
    "        analysis = analyze_thai_phonemes(text)\n",
    "        results.append(analysis)\n",
    "    \n",
    "    # Create visualization\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "    \n",
    "    # Consonant distribution\n",
    "    consonants = [r['consonants'] for r in results]\n",
    "    axes[0, 0].bar(range(len(consonants)), consonants)\n",
    "    axes[0, 0].set_title('Thai Consonants Count')\n",
    "    axes[0, 0].set_xlabel('Text Sample')\n",
    "    axes[0, 0].set_ylabel('Count')\n",
    "    \n",
    "    # Vowel distribution\n",
    "    vowels = [r['vowels'] for r in results]\n",
    "    axes[0, 1].bar(range(len(vowels)), vowels, color='orange')\n",
    "    axes[0, 1].set_title('Thai Vowels Count')\n",
    "    axes[0, 1].set_xlabel('Text Sample')\n",
    "    axes[0, 1].set_ylabel('Count')\n",
    "    \n",
    "    # Tone distribution\n",
    "    tones = [r['tones'] for r in results]\n",
    "    axes[1, 0].bar(range(len(tones)), tones, color='green')\n",
    "    axes[1, 0].set_title('Thai Tones Count')\n",
    "    axes[1, 0].set_xlabel('Text Sample')\n",
    "    axes[1, 0].set_ylabel('Count')\n",
    "    \n",
    "    # Ratios pie chart\n",
",
    "    avg_ratios = {\n",
    "        'Consonants': np.mean([r['consonant_ratio'] for r in results]),\n",
    "        'Vowels': np.mean([r['vowel_ratio'] for r in results]),\n",
    "        'Tones': np.mean([r['tone_ratio'] for r in results])\n",
    "    }\n",
    "    \n",
    "    axes[1, 1].pie(avg_ratios.values(), labels=avg_ratios.keys(), autopct='%1.1f%%')\n",
    "    axes[1, 1].set_title('Average Phoneme Ratios')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return results\n",
    "\n",
    "# Test Thai phoneme analysis\n",
    "print(\"=== Thai Phoneme Analysis ===\")\n",
    "\n",
    "sample_texts = [\n",
    "    \"สวัสดีครับ\",\n",
    "    \"การสังเคราะห์เสียงภาษาไทย\",\n",
    "    \"อรุณสวัสดิ์ค่ะ\",\n",
    "    \"กรุงเทพมหานคร\",\n",
    "    \"ผัดไทยอร่อยมาก\"\n",
    "]\n",
    "\n",
    "# Analyze phonemes\n",
    "for text in sample_texts:\n",
    "    analysis = analyze_thai_phonemes(text)\n",
    "    print(f\"\\nText: {text}\")\n",
    "    print(f\"  Consonants: {analysis['consonants']}\")\n",
    "    print(f\"  Vowels: {analysis['vowels']}\")\n",
    "    print(f\"  Tones: {analysis['tones']}\")\n",
    "    print(f\"  Total Thai chars: {analysis['total_thai_chars']}\")\n",
    "\n",
    "# Visualize distribution\n",
    "print(\"\\n=== Phoneme Distribution Visualization ===\")\n",
    "results = visualize_phoneme_distribution(sample_texts)"
   ]
