   "source": [
    "## 5. Batch Processing for Large Datasets\n",
    "\n",
    "Efficiently process large datasets with batch TTS."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class BatchTTSEngine:\n",
    "    \"\"\"Batch processing TTS engine\"\"\"\n",
    "    \n",
    "    def __init__(self, tts_model, device=\"cpu\", batch_size=8):\n",
    "        self.tts = tts_model\n",
    "        self.device = device\n",
    "        self.batch_size = batch_size\n",
    "        self.results = []\n",
    "    \n",
    "    def prepare_batch_data(self, texts, speaker_wavs=None):\n",
    "        \"\"\"Prepare data for batch processing\"\"\"\n",
",
    "        batch_data = []\n",
    "        \n",
    "        for i, text in enumerate(texts):\n",
    "            # Preprocess Thai text\n",
    "            processed_text = normalize_thai(text)\n",
    "            \n",
    "            # Determine speaker\n",
",
    "            speaker_wav = None\n",
    "            if speaker_wavs:\n",
    "                speaker_wav = speaker_wavs[i % len(speaker_wavs)]\n",
    "            \n",
    "            batch_data.append({\n",
    "                'text': processed_text,\n",
    "                'speaker_wav': speaker_wav,\n",
    "                'index': i\n",
    "            })\n",
    "        \n",
    "        return batch_data\n",
    "    \n",
    "    def process_batch(self, batch_data, output_dir):\n",
    "        \"\"\"Process a batch of TTS requests\"\"\"\n",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "        \n",
    "        batch_results = []\n",
    "        start_time = time.time()\n",
    "        \n",
    "        # Process in batches\n",
    "        for i in range(0, len(batch_data), self.batch_size):\n",
    "            batch_chunk = batch_data[i:i+self.batch_size]\n",
    "            \n",
    "            print(f\"Processing batch {i//self.batch_size + 1}/{(len(batch_data)-1)//self.batch_size + 1}\")\n",
    "            \n",
    "            for item in batch_chunk:\n",
    "                try:\n",
    "                    # Generate audio\n",
    "                    audio = self.tts.tts(\n",
    "                        text=item['text'],\n",
    "                        speaker_wav=item['speaker_wav'],\n",
    "                        language=\"th\"\n",
    "                    )\n",
    "                    \n",
    "                    # Convert to numpy\n",
    "                    if isinstance(audio, torch.Tensor):\n",
    "                        audio = audio.cpu().numpy()\n",
    "                    \n",
    "                    # Save audio\n",
    "                    output_path = os.path.join(\n",
    "                        output_dir, f\"batch_{item['index']}.wav\"\n",
    "                    )\n",
    "                    sf.write(output_path, audio, 22050)\n",
    "                    \n",
    "                    result = {\n",
    "                        'index': item['index'],\n",
    "                        'text': item['text'],\n",
    "                        'audio_path': output_path,\n",
    "                        'duration': len(audio) / 22050,\n",
    "                        'status': 'success'\n",
    "                    }\n",
    "                    \n",
    "                    batch_results.append(result)\n",
    "                    \n",
