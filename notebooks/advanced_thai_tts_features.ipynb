    "## 2. Real-time Streaming TTS\n",
    "\n",
    "Implement real-time streaming for low-latency TTS."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class StreamingTTSEngine:\n",
    "    \"\"\"Real-time streaming TTS engine\"\"\"\n",
    "    \n",
    "    def __init__(self, tts_model, device=\"cpu\"):\n",
    "        self.tts = tts_model\n",
    "        self.device = device\n",
    "        self.audio_queue = queue.Queue()\n",
    "        self.is_streaming = False\n",
    "        self.sample_rate = 22050\n",
    "    \n",
    "    def preprocess_text_streaming(self, text):\n",
    "        \"\"\"Fast text preprocessing for streaming\"\"\"\n",
    "        # Quick Thai normalization\n",
    "        normalized = normalize_thai(text)\n",
    "        return normalized\n",
    "    \n",
    "    def generate_chunk(self, text_chunk, speaker_wav=None):\n",
    "        \"\"\"Generate audio chunk\"\"\"\n",
    "        try:\n",
    "            # Generate audio\n",
    "            audio = self.tts.tts(\n",
    "                text=text_chunk,\n",
    "                speaker_wav=speaker_wav,\n",
    "                language=\"th\"\n",
    "            )\n",
    "            \n",
    "            # Convert to numpy array\n",
    "            if isinstance(audio, torch.Tensor):\n",
    "                audio = audio.cpu().numpy()\n",
    "            \n",
    "            return audio\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error generating chunk: {e}\")\n",
    "            return None\n",
    "    \n",
    "    def stream_tts(self, text, speaker_wav=None, chunk_size=100):\n",
    "        \"\"\"Stream TTS with chunked processing\"\"\"\n",
    "        self.is_streaming = True\n",
    "        \n",
    "        # Preprocess text\n",
    "        processed_text = self.preprocess_text_streaming(text)\n",
    "        \n",
    "        # Split into chunks (simple approach)\n",
    "        words = processed_text.split()\n",
    "        chunks = []\n",
    "        current_chunk = []\n",
    "        \n",
    "        for word in words:\n",
    "            current_chunk.append(word)\n",
    "            if len(current_chunk) >= chunk_size:\n",
    "                chunks.append(\" \".join(current_chunk))\n",
    "                current_chunk = []\n",
    "        \n",
    "        if current_chunk:\n",
    "            chunks.append(\" \".join(current_chunk))\n",
    "        \n",
    "        # Generate audio for each chunk\n",
    "        audio_segments = []\n",
    "        \n",
    "        print(f\"Streaming {len(chunks)} chunks...\")\n",
    "        start_time = time.time()\n",
    "        \n",
    "        for i, chunk in enumerate(chunks):\n",
",
    "            if not self.is_streaming:\n",
    "                break\n",
    "            \n",
    "            chunk_start = time.time()\n",
    "            \n",
    "            # Generate audio for this chunk\n",
    "            audio = self.generate_chunk(chunk, speaker_wav)\n",
    "            \n",
    "            if audio is not None:\n",
    "                audio_segments.append(audio)\n",
    "                self.audio_queue.put(audio)\n",
    "            \n",
    "            chunk_time = time.time() - chunk_start\n",
    "            print(f\"Chunk {i+1}/{len(chunks)}: {chunk_time:.3f}s\")\n",
    "        \n",
    "        total_time = time.time() - start_time\n",
    "        print(f\"Total streaming time: {total_time:.3f}s\")\n",
    "        \n",
    "        # Combine all segments\n",
    "        if audio_segments:\n",
    "            combined_audio = np.concatenate(audio_segments)\n",
    "            return combined_audio\n",
    "        \n",
    "        return None\n",
    "    \n",
    "    def stop_streaming(self):\n",
    "        \"\"\"Stop streaming\"\"\"\n",
    "        self.is_streaming = False\n",
    "\n",
    "# Test streaming TTS\n",
    "print(\"=== Real-time Streaming TTS Test ===\")\n",
    "streaming_engine = StreamingTTSEngine(tts, device)\n",
    "\n",
    "# Test text\n",
    "test_text = \"สวัสดีครับ นี่คือการทดสอบระบบสตรีมมิ่งแบบเรียลไทม์ สำหรับการสังเคราะห์เสียงภาษาไทย\"\n",
    "\n",
    "# Generate streaming audio\n",
    "streamed_audio = streaming_engine.stream_tts(test_text, chunk_size=5)\n",
    "\n",
    "if streamed_audio is not None:\n",
    "    # Save and play\n",
    "    sf.write(\"streaming_output.wav\", streamed_audio, 22050)\n",
    "    print(f\"✅ Streaming complete. Audio length: {len(streamed_audio)/22050:.2f}s\")\n",
    "    ipd.Audio(\"streaming_output.wav\")\n",
    "else:\n",
    "    print(\"❌ Streaming failed\")"
   ]
