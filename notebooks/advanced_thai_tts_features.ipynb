    "class PerformanceOptimizer:\n",
    "    \"\"\"TTS performance optimization\"\"\"\n",
    "    \n",
    "    def __init__(self, tts_model, device):\n",
    "        self.tts = tts_model\n",
    "        self.device = device\n",
    "        self.optimization_stats = []\n",
    "    \n",
    "    def benchmark_tts(self, text, iterations=10):\n",
    "        \"\"\"Benchmark TTS performance\"\"\"\n",
    "        times = []\n",
    "        \n",
    "        print(f\"Benchmarking TTS with {iterations} iterations...\")\n",
    "        \n",
    "        for i in range(iterations):\n",
    "            start_time = time.time()\n",
    "            \n",
    "            # Generate audio\n",
    "            audio = self.tts.tts(text=text, language=\"th\")\n",
    "            \n",
    "            end_time = time.time()\n",
    "            times.append(end_time - start_time)\n",
    "            \n",
    "            print(f\"Iteration {i+1}: {times[-1]:.3f}s\")\n",
    "        \n",
    "        # Statistics\n",
    "        avg_time = np.mean(times)\n",
    "        std_time = np.std(times)\n",
    "        min_time = np.min(times)\n",
    "        max_time = np.max(times)\n",
    "        \n",
    "        stats = {\n",
    "            'average': avg_time,\n",
    "            'std': std_time,\n",
    "            'min': min_time,\n",
    "            'max': max_time,\n",
    "            'iterations': iterations\n",
    "        }\n",
    "        \n",
    "        return stats\n",
    "    \n",
    "    def optimize_memory_usage(self):\n",
    "        \"\"\"Optimize memory usage\"\"\"\n",
    "        if torch.cuda.is_available():\n",
",
    "            # Clear CUDA cache\n",
    "            torch.cuda.empty_cache()\n",
    "            \n",
    "            # Get memory info\n",
    "            allocated = torch.cuda.memory_allocated() / 1024**3\n",
    "            reserved = torch.cuda.memory_reserved() / 1024**3\n",
    "            total = torch.cuda.get_device_properties(0).total_memory / 1024**3\n",
    "            \n",
    "            print(f\"CUDA Memory - Allocated: {allocated:.2f}GB\")\n",
    "            print(f\"CUDA Memory - Reserved: {reserved:.2f}GB\")\n",
    "            print(f\"CUDA Memory - Total: {total:.2f}GB\")\n",
    "            print(f\"CUDA Memory - Free: {total - reserved:.2f}GB\")\n",
    "        \n",
    "        # CPU memory optimization\n",
    "        import gc\n",
    "        gc.collect()\n",
    "        \n",
    "        print(\"✅ Memory optimization complete\")\n",
    "    \n",
    "    def profile_tts(self, text, enable_cuda_profiling=False):\n",
    "        \"\"\"Profile TTS performance\"\"\"\n",
    "        print(\"=== TTS Profiling ===\")\n",
    "        \n",
    "        # CPU profiling\n",
    "        import cProfile\n",
    "        import pstats\n",
    "        \n",
    "        pr = cProfile.Profile()\n",
    "        pr.enable()\n",
    "        \n",
    "        # Generate audio\n",
    "        audio = self.tts.tts(text=text, language=\"th\")\n",
    "        \n",
    "        pr.disable()\n",
    "        \n",
    "        # Print profiling results\n",
    "        stats = pstats.Stats(pr)\n",
    "        stats.sort_stats('cumulative')\n",
    "        print(\"\\nTop 10 time-consuming functions:\")\n",
    "        stats.print_stats(10)\n",
    "        \n",
    "        return stats\n",
    "    \n",
    "    def recommend_optimizations(self, benchmark_stats):\n",
",
    "        \"\"\"Recommend optimizations based on benchmark results\"\"\"\n",
",
    "        recommendations = []\n",
    "        \n",
    "        avg_time = benchmark_stats['average']\n",
    "        \n",
    "        if avg_time > 1.0:\n",
    "            recommendations.append(\"Consider model quantization for faster inference\")\n",
    "        \n",
    "        if avg_time > 0.5:\n",
    "            recommendations.append(\"Enable GPU acceleration if available\")\n",
    "        \n",
    "        if benchmark_stats['std'] > avg_time * 0.3:\n",
    "            recommendations.append(\"High variance detected - consider batching similar texts\")\n",
    "        \n",
    "        if torch.cuda.is_available():\n",
    "            recommendations.append(\"Use mixed precision training for better GPU utilization\")\n",
    "        \n",
    "        recommendations.append(\"Consider model distillation for production deployment\")\n",
    "        \n",
    "        return recommendations\n",
    "\n",
