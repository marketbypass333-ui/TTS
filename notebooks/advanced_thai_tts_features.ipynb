    "class CustomModelTrainer:\n",
    "    \"\"\"Custom Thai TTS model training pipeline\"\"\"\n",
    "    \n",
    "    def __init__(self, device=\"cpu\"):\n",
    "        self.device = device\n",
    "        self.training_config = None\n",
    "    \n",
    "    def create_training_dataset(self, thai_texts, audio_files, output_dir):\n",
    "        \"\"\"Create training dataset from Thai texts and audio\"\"\"\n",
",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "        \n",
    "        dataset = []\n",
    "        \n",
    "        for i, (text, audio_file) in enumerate(zip(thai_texts, audio_files)):\n",
    "            # Preprocess Thai text\n",
    "            processed_text = normalize_thai(text)\n",
    "            \n",
    "            # Get audio info\n",
    "            try:\n",
    "                audio, sr = librosa.load(audio_file)\n",
    "                duration = len(audio) / sr\n",
    "                \n",
    "                dataset_item = {\n",
    "                    'text': processed_text,\n",
    "                    'audio_file': audio_file,\n",
    "                    'duration': duration,\n",
    "                    'audio_sample_rate': sr\n",
    "                }\n",
    "                \n",
    "                dataset.append(dataset_item)\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"Error processing {audio_file}: {e}\")\n",
    "        \n",
    "        # Save dataset metadata\n",
    "        metadata = {\n",
    "            'dataset': dataset,\n",
    "            'total_samples': len(dataset),\n",
    "            'total_duration': sum(item['duration'] for item in dataset),\n",
    "            'created_at': str(datetime.now())\n",
    "        }\n",
    "        \n",
    "        metadata_path = os.path.join(output_dir, 'dataset_metadata.json')\n",
    "        with open(metadata_path, 'w', encoding='utf-8') as f:\n",
    "            json.dump(metadata, f, ensure_ascii=False, indent=2)\n",
    "        \n",
    "        print(f\"✅ Created training dataset: {len(dataset)} samples\")\n",
    "        print(f\"✅ Total duration: {metadata['total_duration']:.2f}s\")\n",
    "        print(f\"✅ Metadata saved: {metadata_path}\")\n",
    "        \n",
    "        return dataset\n",
    "    \n",
    "    def setup_training_config(self, model_name=\"thai_custom_tts\"):\n",
