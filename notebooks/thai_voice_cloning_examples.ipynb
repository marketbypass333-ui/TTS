   "source": [
    "# Thai Voice Cloning Examples\n",
    "\n",
    "This notebook demonstrates voice cloning capabilities for Thai language using the TTS library.\n",
    "\n",
    "## Features:\n",
    "- Voice cloning from reference audio\n",
    "- Thai text preprocessing\n",
    "- Emotion control\n",
    "- Speaker verification\n",
    "\n",
    "## Requirements:\n",
    "- TTS with Thai language support\n",
    "- Reference audio files (WAV, 16kHz, mono)\n",
    "- Thai text samples\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import torch\n",
    "import soundfile as sf\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.io import wavfile\n",
    "import IPython.display as ipd\n",
    "import os\n",
    "import sys\n",
    "\n",
    "# Add TTS to path\n",
    "sys.path.append('../')\n",
    "sys.path.append('../TTS')\n",
    "\n",
    "from TTS.api import TTS\n",
    "from TTS.utils.generic_utils import get_user_data_dir\n",
    "import pythainlp\n",
    "from pythainlp.tokenize import word_tokenize\n",
    "from pythainlp.corpus import thai_stopwords\n",
    "from pythainlp.util import normalize as normalize_thai"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup and Configuration\n",
    "\n",
    "Configure the TTS engine with Thai language support and check available models."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check available TTS models\n",
    "print(\"Available TTS models:\")\n",
    "models = TTS.list_models()\n",
    "for i, model in enumerate(models[:10]):  # Show first 10 models\n",
    "    print(f\"{i+1}. {model}\")\n",
    "\n",
    "# Initialize TTS with Thai support\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"\\nUsing device: {device}\")\n",
    "\n",
    "# For Thai voice cloning, we'll use XTTS model\n",
    "try:\n",
    "    tts = TTS(\"tts_models/multilingual/multi-dataset/xtts_v2\").to(device)\n",
    "    print(\"✅ Loaded XTTS v2 model for Thai voice cloning\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Error loading XTTS model: {e}\")\n",
    "    print(\"Trying alternative model...\")\n",
    "    tts = TTS(\"tts_models/multilingual/multi-dataset/bark\").to(device)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Thai Text Preprocessing\n",
    "\n",
    "Prepare Thai text for TTS processing with proper tokenization and normalization."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def preprocess_thai_text(text):\n",
    "    \"\"\"Preprocess Thai text for TTS\"
",
    "    \n",
    "    Args:\n",
    "        text (str): Raw Thai text\n",
    "    \n",
    "    Returns:\n",
    "        str: Processed Thai text\n",
    "    \"\"\"\n",
    "    # Normalize Thai text\n",
    "    normalized = normalize_thai(text)\n",
    "    \n",
    "    # Tokenize (optional, for analysis)\n",
    "    tokens = word_tokenize(normalized, engine='newmm')\n",
    "    \n",
    "    # Remove stopwords if needed\n",
    "    stopwords = thai_stopwords()\n",
    "    filtered_tokens = [token for token in tokens if token not in stopwords]\n",
    "    \n",
    "    print(f\"Original: {text}\")\n",
    "    print(f\"Normalized: {normalized}\")\n",
    "    print(f\"Tokens: {tokens}\")\n",
    "    print(f\"Filtered: {filtered_tokens}\")\n",
    "    \n",
    "    return normalized\n",
    "\n",
    "# Test with sample Thai text\n",
    "sample_texts = [\n",
    "    \"สวัสดีครับ ยินดีต้อนรับสู่ระบบสังเคราะห์เสียงภาษาไทย\",\n",
    "    \"วันนี้เป็นวันที่ดีมากสำหรับการทดสอบระบบ\",\n",
    "    \"ฉันชอบกินผัดไทยและต้มยำกุ้ง\",\n",
    "    \"กรุงเทพมหานครเป็นเมืองหลวงของประเทศไทย\"\n",
    "]\n",
    "\n",
    "print(\"=== Thai Text Preprocessing Examples ===\")\n",
    "for i, text in enumerate(sample_texts):\n",
    "    print(f\"\\n--- Example {i+1} ---\")\n",
    "    processed_text = preprocess_thai_text(text)\n",
    "    print(f\"Final: {processed_text}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Voice Cloning from Reference Audio\n",
    "\n",
    "Clone a voice from reference audio files. You'll need reference audio in WAV format."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_reference_audio(text, output_path, speaker_wav=None):\n",
    "    \"\"\"Create reference audio for voice cloning\"
",
    "    \n",
    "    Args:\n",
    "        text (str): Text to synthesize\n",
    "        output_path (str): Output audio file path\n",
    "        speaker_wav (str): Reference speaker audio file\n",
    "    \n",
    "    Returns:\n",
    "        str: Path to generated audio\n",
    "    \"\"\"\n",
    "    try:\n",
    "        if speaker_wav:\n",
    "            # Clone voice from reference\n",
    "            tts.tts_to_file(\n",
    "                text=text,\n",
    "                file_path=output_path,\n",
    "                speaker_wav=speaker_wav,\n",
    "                language=\"th\"\n",
    "            )\n",
    "        else:\n",
    "            # Use default voice\n",
    "            tts.tts_to_file(\n",
    "                text=text,\n",
    "                file_path=output_path,\n",
    "                language=\"th\"\n",
    "            )\n",
    "        \n",
    "        print(f\"✅ Generated audio: {output_path}\")\n",
    "        return output_path\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error generating audio: {e}\")\n",
    "        return None\n",
    "\n",
    "def play_audio(audio_path):\n",
    "    \"\"\"Play audio file in notebook\"\"\"\n",
    "    try:\n",
    "        return ipd.Audio(audio_path)\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error playing audio: {e}\")\n",
    "        return None\n",
    "\n",
    "# Create sample reference audio if no reference file exists\n",
    "reference_text = \"สวัสดีครับ นี่คือเสียงตัวอย่างสำหรับการโคลนเสียง\"\n",
    "reference_audio_path = \"reference_speaker.wav\"\n",
    "\n",
    "# Generate initial reference audio\n",
    "print(\"=== Creating Reference Audio ===\")\n",
    "create_reference_audio(reference_text, reference_audio_path)\n",
    "\n",
    "# Play the reference audio\n",
    "play_audio(reference_audio_path)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Voice Cloning Examples\n",
    "\n",
    "Clone different voices and compare the results."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test texts for voice cloning\n",
    "test_texts = [\n",
    "    \"อรุณสวัสดิ์ค่ะ วันนี้คุณรู้สึกอย่างไรบ้าง\",\n",
    "    \"ฉันชอบฟังเพลงไทยสมัยใหม่\",\n",
    "    \"การท่องเที่ยวในประเทศไทยมีความหลากหลายมาก\",\n",
    "    \"ขอบคุณที่ใช้บริการของเรา\"\n",
    "]\n",
    "\n",
    "def clone_multiple_voices(texts, reference_wav, output_dir=\"cloned_voices\"):\n",
    "    \"\"\"Clone multiple voices from reference\"\"\"\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    cloned_files = []\n",
    "    \n",
    "    for i, text in enumerate(texts):\n",
    "        output_path = os.path.join(output_dir, f\"cloned_voice_{i+1}.wav\")\n",
    "        \n",
    "        # Preprocess Thai text\n",
    "        processed_text = preprocess_thai_text(text)\n",
    "        \n",
    "        # Clone voice\n",
    "        result = create_reference_audio(\n",
    "            text=processed_text,\n",
    "            output_path=output_path,\n",
    "            speaker_wav=reference_wav\n",
    "        )\n",
    "        \n",
    "        if result:\n",
    "            cloned_files.append(result)\n",
    "    \n",
    "    return cloned_files\n",
    "\n",
    "# Clone voices\n",
    "print(\"=== Voice Cloning Examples ===\")\n",
    "cloned_files = clone_multiple_voices(test_texts, reference_audio_path)\n",
    "\n",
    "# Play cloned voices\n",
    "print(\"\\n=== Playing Cloned Voices ===\")\n",
    "for i, (text, audio_file) in enumerate(zip(test_texts, cloned_files)):\n",
    "    print(f\"\\n--- Cloned Voice {i+1} ---\")\n",
    "    print(f\"Text: {text}\")\n",
    "    play_audio(audio_file)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Emotion Control\n",
    "\n",
    "Experiment with different emotions and speaking styles."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def generate_with_emotion(text, emotion, reference_wav, output_path):\n",
    "    \"\"\"Generate speech with specific emotion\"
",
    "    \n",
    "    Args:\n",
    "        text (str): Text to synthesize\n",
    "        emotion (str): Emotion style (happy, sad, excited, calm, etc.)\n",
    "        reference_wav (str): Reference speaker audio\n",
    "        output_path (str): Output audio file\n",
    "    \n",
    "    Returns:\n",
    "        str: Path to generated audio\n",
    "    \"\"\"\n",
    "    try:\n",
    "        # Add emotion indicators to text\n",
    "        if emotion == \"happy\":\n",
    "            modified_text = f\"[happy] {text} 😊\"\n",
    "        elif emotion == \"sad\":\n",
    "            modified_text = f\"[sad] {text} 😢\"\n",
    "        elif emotion == \"excited\":\n",
    "            modified_text = f\"[excited] {text} 🎉\"\n",
    "        elif emotion == \"calm\":\n",
    "            modified_text = f\"[calm] {text} 🧘\"\n",
    "        else:\n",
    "            modified_text = text\n",
    "        \n",
    "        # Generate with emotion\n",
    "        tts.tts_to_file(\n",
    "            text=modified_text,\n",
    "            file_path=output_path,\n",
    "            speaker_wav=reference_wav,\n",
    "            language=\"th\"\n",
    "        )\n",
    "        \n",
",
    "        print(f\"✅ Generated {emotion} emotion: {output_path}\")\n",
    "        return output_path\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error generating emotion: {e}\")\n",
    "        return None\n",
    "\n",
    "# Test different emotions\n",
    "emotions = [\"happy\", \"sad\", \"excited\", \"calm\"]\n",
    "emotion_text = \"วันนี้เป็นวันที่ดีมากเลยนะ\"\n",
    "\n",
    "print(\"=== Emotion Control Examples ===\")\n",
    "for emotion in emotions:\n",
    "    output_path = f\"emotion_{emotion}.wav\"\n",
    "    result = generate_with_emotion(\n",
    "        text=emotion_text,\n",
    "        emotion=emotion,\n",
    "        reference_wav=reference_audio_path,\n",
    "        output_path=output_path\n",
    "    )\n",
    "    \n",
    "    if result:\n",
    "        print(f\"Playing {emotion} version:\")\n",
    "        play_audio(result)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Speaker Verification and Similarity\n",
    "\n",
    "Compare the similarity between original and cloned voices."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compare_speaker_similarity(audio1_path, audio2_path):\n",
    "    \"\"\"Compare similarity between two audio files\"\"\"\n",
    "    try:\n",
    "        # Load audio files\n",
    "        data1, sr1 = sf.read(audio1_path)\n",
    "        data2, sr2 = sf.read(audio2_path)\n",
    "        \n",
    "        # Ensure same sample rate\n",
    "        if sr1 != sr2:\n",
    "            print(f\"Warning: Different sample rates {sr1} vs {sr2}\")\n",
    "        \n",
    "        # Simple comparison metrics\n",
    "        # In practice, you'd use more sophisticated methods like speaker embeddings\n",
    "        \n",
    "        # Length comparison\n",
    "        len1, len2 = len(data1), len(data2)\n",
    "        length_ratio = min(len1, len2) / max(len1, len2)\n",
    "        \n",
    "        # Amplitude comparison\n",
    "        amp1, amp2 = np.std(data1), np.std(data2)\n",
    "        amplitude_ratio = min(amp1, amp2) / max(amp1, amp2)\n",
",
    "        print(f\"Audio 1: {audio1_path}\")\n",
    "        print(f\"  Length: {len1} samples, Amplitude: {amp1:.4f}\")\n",
    "        print(f\"Audio 2: {audio2_path}\")\n",
    "        print(f\"  Length: {len2} samples, Amplitude: {amp2:.4f}\")\n",
    "        print(f\"Length similarity: {length_ratio:.2%}\")\n",
    "        print(f\"Amplitude similarity: {amplitude_ratio:.2%}\")\n",
    "        \n",
    "        return {\n",
    "            'length_ratio': length_ratio,\n",
    "            'amplitude_ratio': amplitude_ratio,\n",
    "            'overall_similarity': (length_ratio + amplitude_ratio) / 2\n",
    "        }\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error comparing audio: {e}\")\n",
    "        return None\n",
    "\n",
    "# Test speaker similarity\n",
    "print(\"=== Speaker Similarity Test ===\")\n",
    "if len(cloned_files) >= 2:\n",
    "    similarity = compare_speaker_similarity(reference_audio_path, cloned_files[0])\n",
    "    if similarity:\n",
    "        print(f\"Overall similarity: {similarity['overall_similarity']:.2%}\")\n",
    "else:\n",
    "    print(\"❌ Not enough cloned files for comparison\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Advanced Voice Cloning Features\n",
    "\n",
    "Explore advanced features like voice mixing and style transfer."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def mix_voices(text, reference_wavs, weights, output_path):\n",
    "    \"\"\"Mix multiple reference voices\"\"\"\n",
    "    try:\n",
    "        # This is a simplified example\n",
    "        # In practice, you'd need more sophisticated voice mixing\n",
    "        \n",
    "        print(f\"Mixing {len(reference_wavs)} voices\")\n",
    "        print(f\"Weights: {weights}\")\n",
    "        \n",
    "        # For now, use the first reference with highest weight\n",
",
    "        primary_ref = reference_wavs[np.argmax(weights)]\n",
    "        \n",
    "        tts.tts_to_file(\n",
    "            text=text,\n",
    "            file_path=output_path,\n",
    "            speaker_wav=primary_ref,\n",
    "            language=\"th\"\n",
    "        )\n",
    "        \n",
    "        print(f\"✅ Mixed voice generated: {output_path}\")\n",
    "        return output_path\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error mixing voices: {e}\")\n",
    "        return None\n",
    "\n",
    "# Test voice mixing\n",
    "print(\"=== Voice Mixing Test ===\")\n",
    "mix_text = \"นี่คือเสียงที่ผสมจากหลายเสียง\"\n",
    "mixed_output = \"mixed_voice.wav\"\n",
    "\n",
    "# Create additional reference if needed\n",
    "if len(cloned_files) >= 2:\n",
    "    references = [reference_audio_path, cloned_files[1]]\n",
    "    weights = [0.7, 0.3]  # 70% first voice, 30% second voice\n",
    "    \n",
    "    mixed_result = mix_voices(mix_text, references, weights, mixed_output)\n",
    "    if mixed_result:\n",
    "        play_audio(mixed_result)\n",
    "else:\n",
    "    print(\"❌ Need at least 2 reference voices for mixing\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Export and Save Models\n",
    "\n",
    "Save your trained voice models for future use."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def save_voice_model(reference_wav, model_name, output_dir=\"saved_models\"):\n",
    "    \"\"\"Save voice model for future use\"\"\"\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    \n",
    "    # Copy reference audio as model\n",
",
    "    model_path = os.path.join(output_dir, f\"{model_name}.wav\")\n",
    "    \n",
    "    try:\n",
    "        # Copy the reference file\n",
    "        import shutil\n",
    "        shutil.copy2(reference_wav, model_path)\n",
    "        \n",
    "        # Create metadata\n",
    "        metadata = {\n",
    "            'name': model_name,\n",
    "            'language': 'th',\n",
    "            'reference_file': reference_wav,\n",
    "            'created_at': str(np.datetime64('now'))\n",
    "        }\n",
    "        \n",
    "        import json\n",
    "        metadata_path = os.path.join(output_dir, f\"{model_name}_metadata.json\")\n",
    "        with open(metadata_path, 'w', encoding='utf-8') as f:\n",
    "            json.dump(metadata, f, ensure_ascii=False, indent=2)\n",
    "        \n",
    "        print(f\"✅ Voice model saved: {model_path}\")\n",
    "        print(f\"✅ Metadata saved: {metadata_path}\")\n",
    "        \n",
    "        return model_path\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error saving model: {e}\")\n",
    "        return None\n",
    "\n",
    "# Save the reference voice model\n",
    "print(\"=== Saving Voice Model ===\")\n",
    "saved_model = save_voice_model(reference_audio_path, \"thai_reference_voice\")\n",
    "\n",
    "# List saved models\n",
    "if os.path.exists(\"saved_models\"):\n",
    "    print(\"\\n=== Saved Models ===\")\n",
    "    for file in os.listdir(\"saved_models\"):\n",
    "        print(f\"- {file}\")"
   ]
  },
